{2560战法买入选股  v2}
{2日线+5日线拐头 + 60日线上方 + 缩量回踩MA20}
M1:=2;     {允许跌破MA20幅度(%)}
M2:=60;    {缩量比例(%)}
M3:=0;     {J值上限,0=不启用}
MA2:=MA(CLOSE,2);
MA5:=MA(CLOSE,5);
MA20:=MA(CLOSE,20);
MA60:=MA(CLOSE,60);
{KDJ}
RSV:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
J:=3*SMA(RSV,3,1)-2*SMA(SMA(RSV,3,1),3,1);
V5:=MA(VOL,5);
{2-5-6-0 四条件}
C2:=MA2>=REF(MA2,1);                     {2日线拐头}
C5:=MA5>=REF(MA5,1) OR MA5>=REF(MA5,2); {5日线走平或向上}
C6:=CLOSE>MA60;                           {60日线上方}
C0:=VOL<=V5*M2/100;                       {地量}
{回踩MA20范围}
回踩:=CLOSE>=MA20*(1-M1/100) AND CLOSE<=MA20*(1+3/100);
{可选J值过滤}
J过滤:=IF(M3>0,J<M3,1);
买入:C2 AND C5 AND C6 AND C0 AND 回踩 AND J过滤;
