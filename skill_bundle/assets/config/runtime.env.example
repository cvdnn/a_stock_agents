# Optional private environment settings for skill runtime.
# Copy to local/settings/.env and add credentials there; never put real values in this template.

# User result directory. Relative paths resolve under A_STOCK_WORKSPACE_ROOT.
A_STOCK_OUTPUT_DIR=output

# Default model and optional provider credentials.
A_STOCK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Request timeout, in seconds.
A_STOCK_LLM_TIMEOUT=60.0

# Optional local Ollama endpoint for skill CLI usage.
# OLLAMA_BASE_URL=http://localhost:11434
