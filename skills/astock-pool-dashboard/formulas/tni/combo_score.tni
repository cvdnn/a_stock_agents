[General]
Name=ۺ
Type=ָ

// ==========================================
// ۺ򣨼ָ꣩
// Դ: trading-combo ֿ
// Kͼײʾά
// ==========================================

// ---- ߽ṹ֣25----
MA5:=MA(CLOSE,5);
MA10:=MA(CLOSE,10);
MA20:=MA(CLOSE,20);
MA60:=MA(CLOSE,60);

// ÿһͷϵ+5
߷:=IF(MA5>MA10,5,0)+IF(MA10>MA20,5,0)+IF(MA20>MA60,5,0)+IF(CLOSE>MA20,5,0)+IF(MA5>MA60,5,0);

// ---- MACD״̬֣20----
DIF:="MACD.DIF"(#DAY);
DEA:="MACD.DEA"(#DAY);
MACD:=IF(DIF>0,10,0)+IF(DIF>DEA,10,0);

// ---- ɽ֣15----
VOL5:=MA(VOL,5);
ܷ:=IF(VOL<VOL5*0.9 AND VOL>VOL5*0.5,15,IF(VOL<VOL5*1.2,10,0));

// ---- ۺ ----
:߷+MACD+ܷ;

// ע
DRAWTEXT(>=85, HIGH*1.02, 'A'), COLORRED;
DRAWTEXT(>=70 AND <85, HIGH*1.02, 'B'), COLORLIBLUE;
DRAWTEXT(>=55 AND <70, HIGH*1.02, 'C'), COLORGREEN;
DRAWTEXT(<55, HIGH*1.02, 'D'), COLORGRAY;