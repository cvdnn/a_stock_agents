{2560战法主图指标 v2}
N1:=2;N2:=5;N3:=10;N4:=20;N5:=60;
{★ 死叉均线切换: 10=死叉10日线 15=死叉15日线}
M1:=10;

{均线输出}
MA2:MA(C,N1),COLORWHITE,LINETHICK1;
MA5:MA(C,N2),COLORYELLOW,LINETHICK2;
MA10:MA(C,N3),COLORMAGENTA,LINETHICK1;
MA20:MA(C,N4),COLORGREEN,LINETHICK2;
MA60:MA(C,N5),COLORBLUE,LINETHICK2;

{KDJ}
RSV:=(C-LLV(L,9))/(HHV(H,9)-LLV(L,9))*100;
K:=SMA(RSV,3,1);D:=SMA(K,3,1);J:=3*K-2*D;

{成交量}
V5:=MA(V,5);
缩量:=V<=V5*0.6;
放量:=V>=V5*2;

{--- 买入信号 (2560) ---}
C2:=MA2>=REF(MA2,1);           {2日线拐头}
C5:=MA5>=REF(MA5,1);           {5日线拐头}
C6:=C>MA60;                    {60日线上方}
回踩:=C>MA20 AND C/MA20<1.03;  {回踩MA20}
B1:=回踩 AND 缩量 AND (C2 OR C5) AND C6;
DRAWICON(B1,L*0.98,1);
DRAWTEXT(B1,L*0.94,'2560买'),COLORRED;

{--- 卖出信号 ---}
MA15:=MA(C,15);
S1:=CROSS(MA20,C) AND 放量;          {放量破MA20}
S2A:=CROSS(MA10,MA5);                 {死叉10日}
S2B:=CROSS(MA15,MA5);                 {死叉15日}
S2:=IF(M1=10,S2A,S2B);
S3:=放量 AND C<REF(C,1);              {天量收阴}
卖出:=S1 OR S2 OR S3;
DRAWICON(卖出,H*1.02,2);
DRAWTEXT(卖出,H*1.06,'卖出'),COLORGREEN;

{状态栏}
DRAWTEXT_FIX(1,0,0,0,'2560战法'),COLORRED;
DRAWTEXT_FIX(1,0,0.03,0,'死叉:MA'),COLORWHITE;
DRAWNUMBER_FIX(1,0.04,0.03,0,M1),COLORWHITE;
DRAWTEXT_FIX(1,0,0.06,0,'距MA20:'),COLORYELLOW;
DRAWNUMBER_FIX(1,0.05,0.06,0,(C/MA20-1)*100),COLORYELLOW;
DRAWTEXT_FIX(1,0.09,0.06,0,'%'),COLORYELLOW;
DRAWTEXT_FIX(1,0,0.09,0,'量比:'),COLORMAGENTA;
DRAWNUMBER_FIX(1,0.04,0.09,0,V/V5),COLORMAGENTA;
DRAWTEXT_FIX(1,0,0.12,0,'J值:'),COLORWHITE;
DRAWNUMBER_FIX(1,0.04,0.12,0,J),COLORWHITE;
