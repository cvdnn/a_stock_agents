  "cards": [
    {
      "dot": "cyan",
      "title": "双宿主共用同一内核",
      "items": [
        "Web 侧 server.agent.tools、server.llm、server.tasks 只是 core.* 的薄转发，不复制算法",
        "外部 AI 宿主经 Skill Release 引用 skill_bundle/skills，开发源码不作为发现入口",
        "技能 CLI 不需要启动 FastAPI，宿主也能独立完成受支持任务"
      ]
    },
    {
      "dot": "emerald",
      "title": "三桶落盘纪律",
      "items": [
        "output/ 是用户交付物唯一落盘区，被 .gitignore 与 Release 打包强制排除",
        "log/ 按模块与日期分文件沉淀运行观测；temp/ 只放可重建中间产物",
        "local/ 存有效配置与本地行情库（settings · market_data · server/chats.db）"
      ]
    },
    {
      "dot": "rose",
      "title": "门禁与守护边界",
      "items": [
        "正式路径禁止 Mock 与硬编码行情，未接通能力返回结构化 unavailable",
        "FastAPI 进程内盘后定盘巡检与独立 CLI 守护进程是两个互不控制的主体",
        "选股调度按交易日历门控、同分钟幂等键与排他运行锁，缺数据返回 WAITING_DATA"
      ]
    }
  ]
