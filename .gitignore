# ==============================================================================
# A-Stock Agents Git Ignore Rules (Version Rule: v2, v3, v4...)
# ==============================================================================

# Python runtime
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/
dist/
build/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# OS & Editor residue
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# User Output Data & Private Assets (Complete Isolation)
output/

# System-wide local shared data (market data, server db, caches)
local/
!output/**/.gitkeep
!output/**/*.example
user_data/

# Runtime observation directory (log/) - 系统日志/CLI 轨迹/监控/审计 唯一沉淀区
log/
!log/**/.gitkeep

# Rebuildable intermediate scratch directory (temp/) - 可重建中间产物暂存区
temp/
!temp/**/.gitkeep


# Local runtime caches & databases
cache/
.data_cache/
**/.data_cache/
reports/
backups/
*.db
*.sqlite
*.sqlite3
*.log
*.pid
.server.port

# Environment variables & secrets
.env
.env.*
!.env.example

# Distribution archives
*.zip
*.tar.gz

# Tool scratch & brainstorming workspaces
.superpowers/

