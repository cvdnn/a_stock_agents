# ==============================================================================
# A-Stock Agents Git Ignore Rules (Version Rule: v2, v3, v4...)
# ==============================================================================

# Python runtime
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/
dist/
build/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# OS & Editor residue
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# User Output Data & Private Assets (Complete Isolation)
# 注意：整体忽略目录（output/）会使后续 !negation 失效 —— Git 无法重新纳入被忽略
# 目录内部的条目。故必须先忽略全部内容，再用 !dir/**/ 重新纳入目录本身，
# 占位文件（.gitkeep / .example）的 negation 才会生效，克隆后才能还原目录结构。
output/**
!output/**/
!output/**/.gitkeep
!output/**/*.example

# System-wide local shared data (market data, server db, caches)
local/
user_data/

# Runtime observation directory (log/) - 系统日志/CLI 轨迹/监控/审计 唯一沉淀区
log/**
!log/**/
!log/**/.gitkeep

# Rebuildable intermediate scratch directory (temp/) - 可重建中间产物暂存区
# 该模式含中间分隔符，按 Git 规则锚定仓库根，因此不会命中 web/temp/ 等子层级目录。
temp/**
!temp/**/
!temp/**/.gitkeep

# 前端设计片段归档区 (web/tmp/) —— 刻意纳入版本控制，允许推送至远端。
# 上方 temp/** 不影响本目录；此处显式声明例外，防止将来新增全局 tmp/ 规则时误将其排除。
!web/tmp/
!web/tmp/**


# Local runtime caches & databases
# 注意：cache/ 与 reports/ 必须锚定到仓库根（前导 /），否则会以“任意层级同名目录”
# 匹配到 output/cache/、output/reports/，并在 negation 之后重新忽略它们，
# 使 output/ 下的 .gitkeep / .example 占位无法纳入版本控制。
/cache/
.data_cache/
**/.data_cache/
/reports/
/backups/
*.db
*.sqlite
*.sqlite3
*.log
*.pid
.server.port

# Environment variables & secrets
.env
.env.*
!.env.example

# Distribution archives
*.zip
*.tar.gz

# Tool scratch & brainstorming workspaces
.superpowers/

