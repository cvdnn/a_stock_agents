# ==============================================================================
# A-Stock Agents 环境变量配置模版
# 复制本文件为 .env 即可生效: cp .env.example .env
# ==============================================================================

# 服务端口与监听
A_STOCK_SERVER_HOST=0.0.0.0
A_STOCK_SERVER_PORT=6300
A_STOCK_SERVER_RELOAD=false
A_STOCK_RUNTIME_MODE=production

# 跨域设置 (如有额外前端域名，逗号分隔)
# A_STOCK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 默认推理模型 (按需选择: deepseek-chat, gpt-4o, gemini-1.5-flash 等)
A_STOCK_DEFAULT_MODEL=deepseek-chat

# ================= LLM API 密钥配置 (根据所选模型填写) =================
# 1. DeepSeek (推荐，性价比最高)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 2. OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Google Gemini
GEMINI_API_KEY=

# 4. Anthropic Claude
ANTHROPIC_API_KEY=

# 5. 本地 Ollama (如果容器内访问宿主机 Ollama，Linux/Mac 使用 host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 请求超时时间 (秒)
A_STOCK_LLM_TIMEOUT=60.0
